---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  id?: string;
}
const { index, eyebrow, title, id } = Astro.props;
---

<div class="mb-10 grid gap-4 md:mb-14 md:grid-cols-12 md:items-start" data-reveal>
  <p class="eyebrow flex items-center gap-3 md:col-span-3 md:pt-4">
    <span class="text-accent">{index}</span>
    <span class="h-px w-8 bg-line"></span>
    {eyebrow}
  </p>
  <h2 id={id} class="text-[clamp(2rem,4.5vw,3.4rem)] font-semibold md:col-span-9">{title}</h2>
</div>
