---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { url } from "../lib/url";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}

const { project, headingLevel = "h3", eager = false } = Astro.props;
const { title, description, cover, coverAlt, technologies, category, period } = project.data;
const Heading = headingLevel;
const href = url(`projects/${project.id}/`);
---

<article
  class="group card relative flex h-full flex-col overflow-hidden transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-muted/60"
  data-category={category}
>
  <div class="aspect-[8/5] overflow-hidden border-b border-line bg-bg">
    <img
      src={url(cover)}
      alt={coverAlt}
      width="1200"
      height="750"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
    />
  </div>
  <div class="flex flex-1 flex-col gap-4 p-6 sm:p-7">
    <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>{category}</span><span aria-hidden="true" class="text-line">/</span><span>{period}</span>
    </p>
    <Heading class="text-2xl font-semibold">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">
        {title}
      </a>
    </Heading>
    <p class="text-[0.98rem] text-muted">{description}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Technologies">
      {technologies.slice(0, 4).map((tech) => <li class="tag">{tech}</li>)}
    </ul>
    <span
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent"
      aria-hidden="true"
    >
      Read case study <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
  <style>
    article:has(a:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
  </style>
</article>
