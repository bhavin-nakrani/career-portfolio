---
// Two-page A4 resume. Rendered on /resume/ (on-screen preview) and /resume/print/ (PDF source).
// Pages are split explicitly so the PDF layout is predictable.
import { getCollection } from "astro:content";
import profile from "../data/profile.json";
import experience from "../data/experience.json";
import skills from "../data/skills.json";
import education from "../data/education.json";
import achievements from "../data/achievements.json";
import facts from "../data/facts.json";
import { absoluteUrl, formatMonth, url } from "../lib/url";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const roles = experience.roles;
const PAGE_ONE_ROLES = 4;
const siteUrl = absoluteUrl("", Astro.site);
const prettySite = siteUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");
const linkedin = profile.socialLinks.find((l) => l.id === "linkedin")!;
const github = profile.socialLinks.find((l) => l.id === "github")!;
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const projectLink = (p: (typeof projects)[number]) => p.data.links[0]?.url;
const shortRange = (s: string, e: string | null) =>
  `${formatMonth(s)} – ${formatMonth(e)}`;
---

<div class="resume">
  <!-- Page 1 -->
  <section class="sheet" aria-label="Resume page 1">
    <header class="hero">
      <div class="hero-text">
        <p class="kicker"><span class="dot"></span>{profile.role} · AI-focused Full-Stack Engineer</p>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <ul class="contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={siteUrl}>{prettySite}</a></li>
          <li><a href={linkedin.url}>{strip(linkedin.url)}</a></li>
          <li><a href={github.url}>{strip(github.url)}</a></li>
          <li>{profile.location}</li>
        </ul>
      </div>
      <img class="avatar" src={url("images/profile/avatar.jpg")} alt="" width="600" height="600" />
    </header>

    <div class="cols">
      <div class="main">
        <section>
          <h2>Profile</h2>
          <p class="summary">{profile.resumeSummary}</p>
        </section>

        <section class="facts">
          {facts.items.map((f) => (
            <div><strong>{f.value}</strong><span>{f.label}</span></div>
          ))}
        </section>

        <section>
          <h2>Experience</h2>
          {roles.slice(0, PAGE_ONE_ROLES).map((r) => (
            <article class="role">
              <div class="role-head">
                <h3>{r.title} <span>· {r.company}</span></h3>
                <p class="when">{shortRange(r.startDate, r.endDate)}</p>
              </div>
              <ul>{r.achievements.map((a) => <li>{a}</li>)}</ul>
              <p class="stack">{r.technologies.join(" · ")}</p>
            </article>
          ))}
        </section>
      </div>

      <aside class="side">
        <section class="ai">
          <h2>AI focus</h2>
          <ul>
            {skills.groups[0]!.items.map((s) => <li>{s.name}</li>)}
          </ul>
          <p>Shipped in production: Linkyfy (AI outreach SaaS), KiViP-Concierge (AI agents with human review) and Veroxos (enterprise AI copilot).</p>
        </section>
        {skills.groups.slice(1, 4).map((g) => (
          <section>
            <h2>{g.title}</h2>
            <ul class="chips">
              {g.items.map((s) => <li class:list={[s.level === "primary" && "primary"]}>{s.name}</li>)}
            </ul>
          </section>
        ))}
      </aside>
    </div>
    <footer class="foot"><span>{profile.name} · Resume</span><span>1 / 2</span></footer>
  </section>

  <!-- Page 2 -->
  <section class="sheet" aria-label="Resume page 2">
    <div class="cols cols-2">
      <div class="main">
        <section>
          <h2>Experience <span class="cont">continued</span></h2>
          {roles.slice(PAGE_ONE_ROLES).map((r) => (
            <article class="role">
              <div class="role-head">
                <h3>{r.title} <span>· {r.company}</span></h3>
                <p class="when">{shortRange(r.startDate, r.endDate)}</p>
              </div>
              <ul>{r.achievements.map((a) => <li>{a}</li>)}</ul>
              <p class="stack">{r.technologies.join(" · ")}</p>
            </article>
          ))}
        </section>

        <section>
          <h2>Selected projects</h2>
          <div class="projects">
            {projects.map((p) => (
              <article class="project">
                <h3>
                  {p.data.title}
                  {projectLink(p) && <a href={projectLink(p)}>{strip(projectLink(p)!)}</a>}
                </h3>
                <p>{p.data.description}</p>
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="side">
        {skills.groups.slice(4).map((g) => (
          <section>
            <h2>{g.title}</h2>
            <ul class="chips">
              {g.items.map((s) => <li class:list={[s.level === "primary" && "primary"]}>{s.name}</li>)}
            </ul>
          </section>
        ))}
        <section>
          <h2>Open source</h2>
          <p class="note">Symfony code contributor — listed on symfony.com/contributors.</p>
          <ul class="list">
            {achievements.openSource.items.filter((pr) => !pr.title.startsWith("Release")).map((pr) => (
              <li><a href={pr.url}>{pr.repo.replace("symfony/", "")}#{pr.number}</a> {pr.title}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>Education</h2>
          <ul class="list">
            {education.items.map((e) => (
              <li><strong>{e.qualification}</strong>, {e.field}<br /><span>{e.institution} · {e.endYear}</span></li>
            ))}
          </ul>
        </section>
        <section>
          <h2>Recognition</h2>
          <ul class="list">
            {achievements.items.filter((a) => a.type === "award").map((a) => (
              <li><strong>{a.title}</strong><br /><span>{a.issuer}</span></li>
            ))}
            <li><strong>International work</strong><br /><span>Germany (Stuttgart), Thailand (Bangkok), UAE (Dubai) and the UK (London)</span></li>
          </ul>
        </section>
        <section>
          <h2>Languages</h2>
          <p class="note">{profile.languages.join(" · ")} · Nationality: {profile.nationality}</p>
        </section>
      </aside>
    </div>
    <footer class="foot"><span>{prettySite}</span><span>2 / 2</span></footer>
  </section>
</div>

<style>
  .resume {
    --r-ink: #0b0d10;
    --r-text: #2a313b;
    --r-muted: #5b6573;
    --r-line: #dfe3e8;
    --r-paper: #ffffff;
    --r-side: #f3f5f7;
    --r-accent: #b7f36b;
    --r-accent-ink: #3f6212;
    --r-accent-2: #a7b8ff;
    font-family: "Inter Variable", "Segoe UI", system-ui, sans-serif;
    color: var(--r-text);
    font-size: 7.9pt;
    line-height: 1.42;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .sheet {
    position: relative;
    width: 210mm;
    height: 296.6mm;
    overflow: hidden;
    background: var(--r-paper);
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.7);
    border-radius: 6px;
  }
  .resume a {
    color: inherit;
    text-decoration: none;
  }
  h1,
  h2,
  h3 {
    font-family: "Space Grotesk Variable", "Segoe UI", sans-serif;
    color: var(--r-ink);
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* Header band in the site's dark palette */
  .hero {
    background:
      radial-gradient(circle at 88% 10%, rgb(183 243 107 / 0.28), transparent 45%),
      radial-gradient(circle at 0% 120%, rgb(167 184 255 / 0.2), transparent 50%),
      #0b0d10;
    color: #f3f5f7;
    padding: 9mm 13mm 8mm;
    display: flex;
    gap: 9mm;
    align-items: center;
    justify-content: space-between;
  }
  .hero h1 {
    color: #f3f5f7;
    font-size: 27pt;
    line-height: 1;
    font-weight: 700;
    margin: 2.5mm 0 2mm;
  }
  .kicker {
    margin: 0;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 7pt;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a0a9b5;
    display: flex;
    align-items: center;
    gap: 2mm;
  }
  .dot {
    width: 2.2mm;
    height: 2.2mm;
    border-radius: 50%;
    background: var(--r-accent);
    display: inline-block;
  }
  .headline {
    margin: 0;
    font-family: "Space Grotesk Variable", sans-serif;
    font-size: 11pt;
    color: #d5dae0;
    max-width: 120mm;
  }
  .contact {
    list-style: none;
    padding: 0;
    margin: 4mm 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2mm 4.5mm;
    font-size: 7.6pt;
    color: #a0a9b5;
  }
  .contact li + li::before {
    content: "";
  }
  .contact a {
    color: #f3f5f7;
    border-bottom: 1px solid rgb(183 243 107 / 0.6);
  }
  .avatar {
    width: 31mm;
    height: 31mm;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--r-accent);
    flex-shrink: 0;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 62mm;
    flex: 1;
    min-height: 0;
  }
  .main {
    padding: 7mm 8mm 0 13mm;
  }
  .side {
    background: var(--r-side);
    padding: 7mm 9mm 0 7mm;
  }
  .cols-2 .main,
  .cols-2 .side {
    padding-top: 11mm;
  }
  .main section + section,
  .side section + section {
    margin-top: 4.2mm;
  }
  h2 {
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 2mm;
    margin-bottom: 2.6mm;
  }
  h2::before {
    content: "";
    width: 4mm;
    height: 1.4mm;
    border-radius: 1mm;
    background: var(--r-accent);
  }
  .cont {
    font-weight: 500;
    color: var(--r-muted);
    letter-spacing: 0.08em;
  }
  .summary {
    margin: 0;
    font-size: 8.2pt;
    color: var(--r-text);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--r-line);
    border-radius: 2mm;
  }
  .facts div {
    padding: 2.4mm 3mm;
    display: flex;
    flex-direction: column;
  }
  .facts div + div {
    border-left: 1px solid var(--r-line);
  }
  .facts strong {
    font-family: "Space Grotesk Variable", sans-serif;
    font-size: 13pt;
    color: var(--r-ink);
    line-height: 1.1;
  }
  .facts span {
    font-size: 6.6pt;
    color: var(--r-muted);
    line-height: 1.3;
  }

  .role + .role {
    margin-top: 2.8mm;
    padding-top: 2.8mm;
    border-top: 1px dashed var(--r-line);
  }
  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 3mm;
  }
  .role h3 {
    font-size: 9.6pt;
    font-weight: 700;
  }
  .role h3 span {
    font-weight: 500;
    color: var(--r-text);
  }
  .when {
    margin: 0;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 6.8pt;
    color: var(--r-muted);
    white-space: nowrap;
  }
  .role ul {
    margin: 1.4mm 0 0;
    padding: 0;
    list-style: none;
  }
  .role li {
    position: relative;
    padding-left: 3.6mm;
    margin-top: 0.5mm;
  }
  .role li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 1.8mm;
    height: 1px;
    background: var(--r-accent-ink);
  }
  .stack {
    margin: 1.3mm 0 0;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 6.5pt;
    color: var(--r-accent-ink);
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.6mm 5mm;
  }
  .project h3 {
    font-size: 8.8pt;
    font-weight: 700;
    display: flex;
    flex-direction: column;
  }
  .project h3 a {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 6.4pt;
    font-weight: 500;
    color: var(--r-accent-ink);
    margin-top: 0.3mm;
  }
  .project p {
    margin: 0.8mm 0 0;
    font-size: 7.6pt;
    color: var(--r-text);
  }

  .ai {
    background: #0b0d10;
    color: #d5dae0;
    border-radius: 2.5mm;
    padding: 3.6mm 3.8mm;
  }
  .ai h2 {
    color: #f3f5f7;
  }
  .ai ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ai li {
    padding: 0.7mm 0 0.7mm 3.4mm;
    position: relative;
    color: #f3f5f7;
  }
  .ai li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 1.5mm;
    height: 1.5mm;
    border-radius: 50%;
    background: var(--r-accent);
  }
  .ai p {
    margin: 2mm 0 0;
    font-size: 7.1pt;
    color: #a0a9b5;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2mm;
  }
  .chips li {
    border: 1px solid #ccd3db;
    border-radius: 1.4mm;
    padding: 0.4mm 1.6mm;
    font-size: 6.6pt;
    color: var(--r-text);
    background: #fff;
  }
  .chips li.primary {
    border-color: #9bd14f;
    background: #eefbdc;
    color: var(--r-ink);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li + li {
    margin-top: 1.8mm;
  }
  .list span {
    color: var(--r-muted);
    font-size: 7.2pt;
  }
  .list a {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 6.8pt;
    color: var(--r-accent-ink);
  }
  .note {
    margin: 0 0 2mm;
    color: var(--r-text);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    padding: 3mm 13mm 4mm;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 6.4pt;
    color: var(--r-muted);
    border-top: 1px solid var(--r-line);
    background: var(--r-paper);
  }

  /* On small screens the preview reflows instead of showing a scaled A4 sheet. */
  @media screen and (max-width: 860px) {
    .sheet {
      width: 100%;
      height: auto;
    }
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      padding: 8mm 6mm;
    }
    .cols {
      grid-template-columns: 1fr;
    }
    .main,
    .side,
    .cols-2 .main,
    .cols-2 .side {
      padding: 6mm;
    }
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts div:nth-child(3) {
      border-left: 0;
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--r-line);
    }
    .projects {
      grid-template-columns: 1fr;
    }
    .role-head {
      flex-direction: column;
    }
    .resume {
      font-size: 10pt;
    }
  }

  @media print {
    .resume {
      gap: 0;
      display: block;
    }
    .sheet {
      box-shadow: none;
      border-radius: 0;
      break-after: page;
    }
    .sheet:last-child {
      break-after: auto;
    }
  }
</style>
