---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import profile from "../../data/profile.json";
import { absoluteUrl, url } from "../../lib/url";

export const getStaticPaths = (async () => {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      related: [projects[(i + 1) % projects.length], projects[(i + 2) % projects.length]],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<"projects">;
  related: CollectionEntry<"projects">[];
}

const { project, related } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const meta = [
  { label: "Role", value: d.role },
  { label: "Period", value: d.period },
  { label: "Context", value: d.context },
  { label: "Category", value: d.category },
];

const ld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: d.title,
  description: d.description,
  url: absoluteUrl(`projects/${project.id}/`, Astro.site),
  image: absoluteUrl(d.cover, Astro.site),
  creator: { "@type": "Person", name: profile.name },
  keywords: d.technologies.join(", "),
};
---

<BaseLayout title={d.title} description={d.description} ogType="article" jsonLd={ld}>
  <article>
    <header class="grid-bg border-b border-line">
      <div class="container-x pt-10 pb-14 md:pt-14 md:pb-20">
        <a href={url("projects/")} class="inline-flex min-h-11 items-center gap-2 text-sm text-muted hover:text-ink">
          <Icon name="arrow-left" size={16} /> All projects
        </a>
        <p class="eyebrow mt-8">{d.category} · {d.period}</p>
        <h1 class="mt-4 max-w-4xl text-[clamp(2.5rem,6.5vw,5rem)] leading-[1.02] font-semibold">{d.title}</h1>
        <p class="mt-6 max-w-3xl text-[clamp(1.1rem,2vw,1.35rem)] text-muted">{d.description}</p>
        {
          d.links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {d.links.map((l, i) => (
                <a href={l.url} target="_blank" rel="noopener" class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]}>
                  Visit {l.label} <Icon name="arrow-up-right" size={16} />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="container-x py-12 md:py-16">
      <figure class="overflow-hidden rounded-3xl border border-line bg-surface">
        <img src={url(d.cover)} alt={d.coverAlt} width="1200" height="750" fetchpriority="high" class="w-full" />
      </figure>
      <p class="mt-3 text-center text-xs text-muted">Illustration — not a product screenshot.</p>
    </div>

    <div class="container-x grid gap-12 pb-24 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-28">
          <dl class="card divide-y divide-line">
            {
              meta.map((m) => (
                <div class="px-6 py-4">
                  <dt class="eyebrow">{m.label}</dt>
                  <dd class="mt-1 text-[0.98rem] text-ink">{m.value}</dd>
                </div>
              ))
            }
            <div class="px-6 py-4">
              <dt class="eyebrow">Stack</dt>
              <dd class="mt-3">
                <ul class="flex flex-wrap gap-2">{d.technologies.map((t) => <li class="tag">{t}</li>)}</ul>
              </dd>
            </div>
          </dl>
          {
            d.results.length > 0 && (
              <div class="card border-accent/40 p-6">
                <p class="eyebrow text-accent">Results</p>
                <ul class="mt-4 space-y-3">
                  {d.results.map((r) => (
                    <li class="flex gap-3 text-[0.98rem] text-ink">
                      <span class="mt-2.5 h-1.5 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      {r}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>

      <div class="prose-case lg:col-span-7 lg:col-start-6">
        <Content />
      </div>
    </div>
  </article>

  <section class="border-t border-line py-20" aria-labelledby="more-title">
    <div class="container-x">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 id="more-title" class="text-3xl font-semibold">More projects</h2>
        <a href={url("projects/")} class="inline-flex items-center gap-2 text-sm font-semibold text-accent">
          View all <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          related.map((p) => (
            <li>
              <ProjectCard project={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
